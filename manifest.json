{
  "manifest_version": 3,
  "name": "YouTube Auto Skip",
  "version": "1.0.0",
  "description": "Automatically clicks YouTube's Skip Ad button when it appears.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
